# ───────── 사이트 ─────────
# 운영 도메인 (canonical, sitemap, OG에 사용)
NEXT_PUBLIC_SITE_URL=https://example.or.kr

# ───────── DB (Neon Postgres) ─────────
# 비워두면 로컬 개발용 내장 DB(PGlite, .data/pglite)를 사용합니다. 운영에서는 필수.
DATABASE_URL=

# ───────── 파일 저장소 (Vercel Blob) ─────────
# Vercel 대시보드 Storage 에서 Blob 스토어를 프로젝트에 연결하면 자동으로 주입됩니다.
# 비워두면 로컬 개발용 파일 저장소(.data/uploads)를 사용합니다.
BLOB_READ_WRITE_TOKEN=

# ───────── 관리자 ─────────
ADMIN_ID=admin
# `npm run hash-password -- '비밀번호'` 로 생성한 값 (bcrypt 해시를 base64로 인코딩한 문자열)
ADMIN_PASSWORD_HASH=
# 32자 이상 임의 문자열 (`openssl rand -base64 32`)
AUTH_SECRET=

# ───────── 검색엔진 소유 확인 ─────────
# 네이버 서치어드바이저 > 사이트 등록 > HTML 태그의 content 값
NAVER_SITE_VERIFICATION=
# 구글 서치콘솔 > HTML 태그의 content 값
GOOGLE_SITE_VERIFICATION=
